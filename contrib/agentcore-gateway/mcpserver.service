[Unit]
Description=AgentCore Lambda Tool MCP Server (streamable-http, stateless)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/mcp/src/lambda-tool-mcp-server

Environment=MCP_TRANSPORT=streamable-http
Environment=MCP_HOST=0.0.0.0
Environment=MCP_PORT=8000
Environment=MCP_STATELESS_HTTP=true
# ALB のヘルスチェックと Gateway 経由のリクエストは Host が localhost に
# ならないため、DNS rebinding 保護を切らないと弾かれる
Environment=MCP_DNS_REBINDING_PROTECTION=false
Environment=AWS_REGION=ap-northeast-1
# 公開したい Lambda を絞る。未設定だと全関数がツールとして登録される
Environment=FUNCTION_PREFIX=agentcore-gateway-

ExecStart=/home/ec2-user/.local/bin/uv run awslabs.lambda-tool-mcp-server

Restart=always
RestartSec=5

# ログは journald に出す。ファイルパスを指定すると書き込み権限が無い場合に
# "Failed to set up standard output: Permission denied" で起動失敗し、
# Restart=always と相まって無限リスタートループになる（実際に踏んだ）。
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
